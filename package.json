{
  "name": "api-test-studio",
  "version": "1.9.0",
  "private": true,
  "description": "Single-file Scalar/Postman-style runner for the Swivl Template API — hosted at https://anbuswivl12.github.io/API-TEST-STUDIO/",
  "scripts": {
    "start": "bash start.sh",
    "dev": "bash start.sh",
    "serve": "npx --yes serve . -l 5173 --no-clipboard",
    "preview": "open http://localhost:5173 || xdg-open http://localhost:5173 || true",
    "tunnel": "npx --yes localtunnel --port 5173",
    "deploy:pages": "bash deploy.sh",
    "worker:install": "cd worker && npm install",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "worker:kv": "cd worker && npx wrangler kv:namespace create STATE",
    "deploy": "bash deploy.sh"
  },
  "homepage": "https://anbuswivl12.github.io/API-TEST-STUDIO/"
}
